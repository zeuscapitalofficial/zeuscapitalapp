// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  name          String
  email         String
  emailVerified Boolean        @default(false)
  image         String?
  role          Role           @default(USER)
  referralCode  String?        @unique
  referredById  String?
  referredBy    User?          @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals     User[]         @relation("UserReferrals")
  balance       Float          @default(0.0)
  totalProfit   Float          @default(0.0)
  totalDeposit  Float          @default(0.0)
  bonusRewards  Float          @default(0.0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  kyc           Kyc?
  notifications     Notification[]
  apiKeys           ApiKey[]
  chatConversations ChatConversation[]
  transactions      Transaction[]
  quests            UserQuest[]
  streak            UserStreak?
  paymentMethods    PaymentMethod[]

  @@unique([email])
  @@index([referredById])
  @@map("user")
}

enum Role {
  USER
  ADMIN
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model Kyc {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          String
  countryCode     String
  country         String
  phoneNumber     String
  documentId      String
  frontOfId       String    // File name or base64 data url for the front image
  backOfId        String    // File name or base64 data url for the back image
  proofOfAddress  String    // File name or base64 data url for proof of address
  password        String?   // Plain text optional password (not hashed)
  
  // Standard Compliance Fields
  addressLine1    String
  city            String
  state           String
  postalCode      String
  nationality     String
  sourceOfFunds   String    // Source of funds selector value
  extraNotes      String?   // Additional compliance remarks
  rejectionReason String?   // Notes from auditor if rejected

  status          KycStatus @default(PENDING)
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("kyc")
}

model PriceOverride {
  coinId    String   @id // e.g. "bitcoin", "ethereum"
  priceUsd  Float
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("price_override")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // INFO, WARNING, SECURITY, DEPOSIT, WITHDRAWAL, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notification")
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String   // Store hashed key
  prefix    String   // First few chars for display
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("api_key")
}

model ChatConversation {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String?
  isOpen      Boolean       @default(true)
  lastMessage String?
  lastAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]

  @@index([userId])
  @@map("chat_conversation")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  content        String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@map("chat_message")
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // DEPOSIT, WITHDRAWAL, PURCHASE
  asset     String   // e.g. "USDT (TRC-20)", "BTC"
  amount    Float
  txHash    String?
  address   String?
  status    String   @default("PENDING") // PENDING, COMPLETED, REJECTED
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("transaction")
}

model UserQuest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  completed Boolean  @default(false)
  claimed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, questId])
  @@map("user_quest")
}

model UserStreak {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDay  Int      @default(1)
  lastClaimAt DateTime @default(now())
  claimedDays String   @default("[]") // JSON array of claimed day numbers e.g. "[1,2]"

  @@map("user_streak")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g. "BTC", "USDT_TRC20", "ETH", "BANK_TRANSFER"
  label     String   // e.g. "Primary Trading Wallet", "Personal Ledger"
  address   String   // Wallet address or Bank account details
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("payment_method")
}
